@env = local
@host = {{host}}

### Find All
GET {{host}}/api/user

### Find All By Filter
POST {{host}}/api/user/filter
Content-Type: application/json

{
  "pageNumber": 0,
  "pageSize": 10,
  "search": null,
  "payload": {
    "active": true
  }
}

### Find By Id
GET {{host}}/api/user/1

